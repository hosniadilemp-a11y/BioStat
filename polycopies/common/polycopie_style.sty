% --------------------------------------------------------
% Macro d'En-tête Officielle du Polycopié avec QR Code
% --------------------------------------------------------
\newcommand{\makepolycopieheader}[3]{%
  \begin{tcolorbox}[
    colback=BioNavyLight,
    colframe=BioNavy,
    arc=4mm,
    boxrule=1.2pt,
    left=12pt, right=12pt, top=10pt, bottom=10pt
  ]
    \begin{minipage}[c]{0.65\textwidth}
      {\footnotesize \textbf{Université M'Hamed Bougara de Boumerdès (UMBB)}}\\[1mm]
      {\footnotesize Faculté des Sciences --- Département de Biologie}\\[1mm]
      {\footnotesize \textbf{Master 2 :} Biochimie Appliquée (Semestre 3)}\\[1mm]
      {\footnotesize Module : \textbf{Biostatistiques Appliquées \& Modélisation}}\\[1mm]
      {\scriptsize \faUserTie\ Enseignante : \textbf{Dr. Sarra BENMOUMOU-HOSNI (Ph.D.)}}
    \end{minipage}
    \hfill
    \begin{minipage}[c]{0.32\textwidth}
      \centering
      \qrcode[height=1.75cm]{https://hosniadilemp-a11y.github.io/BioStat/}\\[1mm]
      {\scriptsize \textcolor{BioNavy}{\textbf{\faMobile\ Portail Interactif Web}}}\\[-0.5mm]
      {\tiny \textcolor{gray}{Scannez pour les simulateurs}}
    \end{minipage}
    
    \vspace{2mm}
    \hrule height 0.8pt color BioNavy
    \vspace{3mm}
    
    \begin{center}
      {\small \color{BioTeal}\textbf{\faBookOpen\ SUPPORT DE COURS \& GUIDE PRATIQUE RÉDIGÉ (#3)}}\\[1.5mm]
      {\LARGE \color{BioNavy}\textbf{#1}}\\[1.5mm]
      {\normalsize \color{BioDark}#2}
    \end{center}
  \end{tcolorbox}
  \vspace{4mm}
}

