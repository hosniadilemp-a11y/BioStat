% --------------------------------------------------------
% Macro de Titre Officiel Universitaire
% --------------------------------------------------------
\newcommand{\makeuniversityheader}[3]{%
  \begin{tcolorbox}[
    colback=BioNavyLight,
    colframe=BioNavy,
    arc=4mm,
    boxrule=1pt,
    left=12pt, right=12pt, top=10pt, bottom=10pt
  ]
    \begin{minipage}[c]{0.70\textwidth}
      {\footnotesize \textbf{Université M'Hamed Bougara de Boumerdès (UMBB)}}\\[1mm]
      {\footnotesize Faculté des Sciences --- Département de Biologie}\\[1mm]
      {\footnotesize \textbf{Master 2 :} Biochimie Appliquée (Semestre 3)}\\[1mm]
      {\footnotesize Module : \textbf{Biostatistiques Appliquées \& Plans d'Expériences}}
    \end{minipage}
    \hfill
    \begin{minipage}[c]{0.28\textwidth}
      \flushright
      {\footnotesize \textbf{Année 2024 -- 2025}}\\[1mm]
      {\footnotesize \faUserTie\ \textbf{Dr. S. BENMOUMOU}}\\[1mm]
      {\scriptsize Enseignante Responsable}\\[1mm]
      \textbf{#3}
    \end{minipage}
    
    \vspace{2mm}
    \hrule height 0.8pt color BioNavy
    \vspace{3mm}
    
    \begin{center}
      {\Large \color{BioNavy}\textbf{#1}}\\[1.5mm]
      {\normalsize \color{BioTeal}\textbf{#2}}
    \end{center}
  \end{tcolorbox}
  \vspace{4mm}
}

% --------------------------------------------------------
% Environnements d'Exercices et de Solutions
% --------------------------------------------------------
\newtcolorbox{exercicebox}[2][]{
  colback=white,
  colframe=BioNavy,
  fonttitle=\bfseries,
  title={\faFlask\quad #2},
  boxrule=0.8pt,
  arc=3mm,
  left=10pt, right=10pt, top=8pt, bottom=8pt,
  before skip=12pt, after skip=12pt,
  coltitle=white,
  colbacktitle=BioNavy,
  breakable,
  #1
}

\newtcolorbox{solutionbox}[2][]{
  colback=BioTealLight,
  colframe=BioTeal,
  fonttitle=\bfseries,
  title={\faCheckCircle\quad Solution Détaillée --- #2},
  boxrule=0.8pt,
  arc=3mm,
  left=10pt, right=10pt, top=8pt, bottom=8pt,
  before skip=12pt, after skip=12pt,
  coltitle=white,
  colbacktitle=BioTeal,
  breakable,
  #1
}

\newtcolorbox{astucebox}[1][Astuce Méthodologique]{
  colback=BioAmberLight,
  colframe=BioAmber,
  fonttitle=\bfseries,
  title={\faLightbulb\quad #1},
  boxrule=0.8pt,
  arc=2mm,
  left=8pt, right=8pt, top=6pt, bottom=6pt,
  before skip=8pt, after skip=8pt,
  coltitle=BioDark,
  colbacktitle=BioAmberLight!80,
  breakable
}

\newtcolorbox{biotakeaway}[1][Interprétation Biologique]{
  colback=BioGreenLight,
  colframe=BioGreen,
  fonttitle=\bfseries,
  title={\faLeaf\quad #1},
  boxrule=0.8pt,
  arc=2mm,
  left=8pt, right=8pt, top=6pt, bottom=6pt,
  before skip=8pt, after skip=8pt,
  coltitle=white,
  colbacktitle=BioGreen,
  breakable
}
